---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyButton from '../../components/CopyButton.astro';
import { renderInlineMarkdown } from '../../lib/inlineMarkdown';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((lab) => ({
    params: { id: lab.data.id },
    props: { lab },
  }));
}

interface Props {
  lab: CollectionEntry<'labs'>;
}

const { lab } = Astro.props;
const { data } = lab;

// Mesma heurística de site/scripts/build-catalog.mjs — se mudar lá, mudar aqui.
const PLACEHOLDER_MARKERS = ['SEU_USUARIO', 'ghcr.io/codisec/lab-'];
const imagePublished = !PLACEHOLDER_MARKERS.some((marker) => data.image.includes(marker));

const difficultyLabel: Record<string, string> = {
  beginner: 'iniciante',
  intermediate: 'intermediário',
  advanced: 'avançado',
};
---
<BaseLayout title={`${data.title} — Codisec Labs`} description={data.description}>
  <section style="border-top:none;">
    <div class="lab-layout">
      <div class="lab-sidebar">
        <span class="lab-badge">{data.category}</span>
        <span class="lab-badge">{difficultyLabel[data.difficulty]}</span>
        <span class="lab-badge">{data.duration}</span>

        <h1 style="margin-top:16px; font-size:26px;">{data.title}</h1>
        <p style="color:var(--muted); margin-top:12px; font-size:14.5px;">{data.description}</p>

        {!imagePublished && (
          <div class="lab-warning">
            ⚠️ A imagem Docker deste lab (<code>{data.image}</code>) ainda não
            foi publicada pela equipe — o comando abaixo não funciona por
            enquanto. Acompanhe o progresso em docs/CHECKLIST.md.
          </div>
        )}

        {data.requires_privileged && (
          <div class="lab-warning">
            ⚠️ Este lab roda em <strong>modo privilegiado</strong>{' '}
            (Docker-in-Docker) — equivalente a acesso root na sua máquina.
            A CLI vai pedir confirmação explícita antes de iniciar (ver
            "Labs que exigem modo privilegiado" em docs/SECURITY.md no
            repositório).
          </div>
        )}

        {!data.requires_privileged && data.required_capabilities.length > 0 && (
          <div class="lab-notice">
            ℹ️ Este lab pede a permissão de rede{' '}
            <strong>{data.required_capabilities.join(', ')}</strong>{' '}
            — mais restrito que modo privilegiado, mas maior que o
            padrão de um container comum. A CLI vai pedir confirmação
            antes de iniciar (ver "Labs que exigem capabilities
            específicas" em docs/SECURITY.md no repositório).
          </div>
        )}

        <div style="margin-top:24px;">
          <p style="font-size:13px; color:var(--muted); margin-bottom:4px;">Rode este lab localmente:</p>
          <CopyButton command={`codisec lab start ${data.id}`} />
        </div>

        <p style="font-size:12.5px; color:var(--muted); margin-top:16px;">
          Ainda não tem a CLI? <a href="/#instalar" style="color:var(--cyan);">Veja como instalar</a>.
          Pré-requisito: Docker Desktop instalado e aberto.
        </p>
      </div>

      <div>
        {data.tasks.map((task, i) => (
          <div class="task-card">
            <h3>{task.title}</h3>
            <p class="theory" set:html={renderInlineMarkdown(task.theory)} />
            <ol>
              {task.steps.map((step) => <li set:html={renderInlineMarkdown(step)} />)}
            </ol>
            <p class="validation-hint">
              Valide com <code>codisec lab validate {data.id} {task.id}</code>
            </p>
          </div>
        ))}

        <div class="task-card">
          <h3>Recuperar o lab</h3>
          <p class="theory">
            Se algo der errado e você quiser recomeçar esta tarefa do zero,
            sem perder o container inteiro:
          </p>
          <p class="validation-hint">
            <code>codisec lab reset {data.id}</code>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
