"""
REFERÊNCIA — não é copiado pelo container em nenhum momento.
Mostra a correção esperada da task 3 do lab.yaml.
"""
import re
from urllib.parse import urlparse
import requests
from flask import Flask, request, jsonify, abort

app = Flask(__name__)

TITLE_RE = re.compile(r"<title[^>]*>(.*?)</title>", re.IGNORECASE | re.DOTALL)

ALLOWED_HOSTS = {"example.com", "wikipedia.org"}


@app.route("/preview", methods=["POST"])
def preview():
    data = request.get_json(silent=True) or {}
    url = data.get("url", "")
    if not url:
        abort(400)

    # CORRIGIDO: allowlist explícita de hosts permitidos, checada ANTES
    # de fazer a requisição — nunca uma blocklist (contornável).
    hostname = urlparse(url).hostname
    if hostname not in ALLOWED_HOSTS:
        abort(403)

    try:
        resp = requests.get(url, timeout=5)
    except requests.RequestException as e:
        return jsonify({"error": str(e)}), 502

    match = TITLE_RE.search(resp.text)
    title = match.group(1).strip() if match else None

    return jsonify({"title": title, "body_snippet": resp.text[:500]})


@app.route("/healthz")
def healthz():
    return jsonify({"status": "ok"})


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
